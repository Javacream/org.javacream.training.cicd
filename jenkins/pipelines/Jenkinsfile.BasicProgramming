pipeline {
    agent any
    environment {
        NAME = 'Sawitzki'
    }
    stages {
        stage('Hello') {
            environment {
                SUFFIX = '!'
            }
            steps {
                echo "Hello ${NAME} ${SUFFIX}"
                writeFile(file: 'data.txt', text: 'From Stage Hello')
            }
        }
        stage('Goodbye') {
            steps {
                echo "Goodbye ${NAME}"
                readFile(file: 'data.txt')
            }
        }
    }
}