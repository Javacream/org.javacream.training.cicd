FROM jenkins/ssh-agent:jdk21

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      maven \
      git \
      curl \
      ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Keep root so the Jenkins SSH agent startup script can configure sshd
USER root
